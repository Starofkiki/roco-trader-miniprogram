page {
  min-height: 100vh;
  background: #f8f1e7;
  color: #201a12;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.container {
  padding: 28rpx 28rpx calc(196rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: rgba(255, 253, 248, 0.96);
  border-radius: 22rpx;
  box-shadow: 0 12rpx 32rpx rgba(69, 48, 20, 0.08);
  border: 1rpx solid rgba(211, 189, 154, 0.68);
}

.section-title {
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 800;
  color: #201a12;
}

.muted {
  color: #786b5c;
}

.tag {
  display: inline-flex;
  align-items: center;
  height: 36rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-normal { background: #efe1ce; color: #514532; }
.tag-rare { background: #eee6ff; color: #5f3bb1; }
.tag-limited { background: #dff0f4; color: #075a6c; }

.primary-btn {
  height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f7b72d 0%, #e08b18 100%);
  color: #3c2a06;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 24rpx rgba(194, 120, 15, 0.2);
}

.primary-btn:active {
  transform: translateY(1rpx);
  opacity: 0.9;
}

.ghost-btn {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #7a4f0a;
  background: #fff8ed;
  border: 1rpx solid #d4bd98;
  font-size: 24rpx;
  font-weight: 700;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
