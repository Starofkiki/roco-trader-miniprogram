.profile-page {
  padding-top: 30rpx;
}

.menu-card {
  overflow: hidden;
}

.menu-row {
  min-height: 112rpx;
  padding: 22rpx 28rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #ead9bf;
  box-sizing: border-box;
}

.menu-row:last-child { border-bottom: none; }

.menu-row:active {
  background: #fff1dc;
}

.menu-main { flex: 1; min-width: 0; }

.menu-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #201a12;
}

.menu-sub {
  display: block;
  margin-top: 8rpx;
  color: #857765;
  font-size: 23rpx;
  line-height: 32rpx;
}

.arrow {
  color: #b3a892;
  font-size: 52rpx;
  line-height: 52rpx;
}

.official-account-mask {
  position: fixed;
  z-index: 1000;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(42, 31, 18, 0.58);
}

.official-account-dialog {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 44rpx 42rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
  border: 2rpx solid #e6c78d;
  border-radius: 30rpx;
  background: #fffaf0;
  box-shadow: 0 24rpx 64rpx rgba(52, 37, 17, 0.24);
}

.official-account-close {
  position: absolute;
  top: 18rpx;
  right: 22rpx;
  width: 56rpx;
  height: 56rpx;
  color: #8b7558;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 50rpx;
  text-align: center;
}

.official-account-kicker {
  color: #a9782c;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 5rpx;
}

.official-account-title {
  margin-top: 12rpx;
  color: #2b2116;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.official-account-desc {
  margin-top: 8rpx;
  color: #756550;
  font-size: 25rpx;
  line-height: 36rpx;
}

.official-account-qr-frame {
  width: 396rpx;
  height: 396rpx;
  margin-top: 28rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border: 2rpx solid #ead6ad;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: inset 0 0 0 8rpx #fff8e9;
}

.official-account-qr {
  width: 100%;
  height: 100%;
  display: block;
}

.official-account-tip {
  margin-top: 22rpx;
  color: #756550;
  font-size: 23rpx;
  line-height: 34rpx;
  text-align: center;
}

.official-account-preview {
  min-width: 276rpx;
  height: 74rpx;
  margin-top: 26rpx;
  padding: 0 34rpx;
  border-radius: 37rpx;
  background: #c58a2b;
  color: #fffdf8;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 74rpx;
}

.official-account-preview::after {
  border: none;
}
