<view class="container profile-page">
  <view class="menu-card card">
    <view class="menu-row" bindtap="goFeedback">
      <view class="menu-main">
        <text class="menu-title">问题反馈</text>
        <text class="menu-sub">反馈商品数据、页面显示或功能建议</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="openOfficialAccountGuide">
      <view class="menu-main">
        <text class="menu-title">关注公众号</text>
        <text class="menu-sub">查看功能更新、商品复盘与使用说明</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goAnnouncements">
      <view class="menu-main">
        <text class="menu-title">历史公告</text>
        <text class="menu-sub">查看已发布公告和更新通知</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goAbout">
      <view class="menu-main">
        <text class="menu-title">关于工具</text>
        <text class="menu-sub">版本说明与数据声明</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view wx:if="{{isAdmin}}" class="menu-row" bindtap="goAdmin">
      <view class="menu-main">
        <text class="menu-title">管理员入口</text>
        <text class="menu-sub">人工兜底、推送、公告与反馈</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view
    wx:if="{{showOfficialAccountGuide}}"
    class="official-account-mask"
    catchtap="closeOfficialAccountGuide"
    catchtouchmove="stopPropagation"
  >
    <view class="official-account-dialog" catchtap="stopPropagation">
      <view class="official-account-close" catchtap="closeOfficialAccountGuide">×</view>
      <text class="official-account-kicker">远行商人记录本</text>
      <text class="official-account-title">关注公众号</text>
      <text class="official-account-desc">长按识别二维码关注</text>

      <view class="official-account-qr-frame" bindtap="previewOfficialAccountQr">
        <image
          class="official-account-qr"
          src="{{officialAccountQrCode}}"
          mode="aspectFit"
          show-menu-by-longpress
        />
      </view>

      <text class="official-account-tip">获取功能更新、商品复盘与使用说明</text>
      <button class="official-account-preview" bindtap="previewOfficialAccountQr">查看二维码大图</button>
    </view>
  </view>
</view>
