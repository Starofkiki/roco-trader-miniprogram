.products-page {
  padding-top: 20rpx;
}

.product-section + .product-section {
  margin-top: 18rpx;
}

.focus-section + .product-section {
  margin-top: 30rpx;
}

.group-head {
  height: 46rpx;
  margin: 0 2rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.group-head.collapsible {
  height: 64rpx;
  margin-bottom: 0;
  padding: 0 16rpx;
  border: 1rpx solid rgba(211, 189, 154, 0.52);
  border-radius: 14rpx;
  background: rgba(255, 250, 240, 0.86);
  box-sizing: border-box;
}

.product-section.is-expanded .group-head {
  margin-bottom: 14rpx;
  border-color: rgba(199, 170, 125, 0.72);
  background: #fff8eb;
}

.group-mark {
  width: 8rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #c7aa7d;
  flex-shrink: 0;
}

.group-title {
  color: #30261c;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.group-toggle {
  width: 34rpx;
  height: 34rpx;
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.group-chevron {
  width: 12rpx;
  height: 12rpx;
  margin-top: -6rpx;
  border-right: 3rpx solid #8a704d;
  border-bottom: 3rpx solid #8a704d;
  transform: rotate(45deg);
  transition: transform 180ms ease, margin 180ms ease;
}

.group-toggle.expanded .group-chevron {
  margin-top: 6rpx;
  transform: rotate(225deg);
}

.focus-section .group-mark {
  background: #d59c38;
  box-shadow: 0 0 0 5rpx rgba(213, 156, 56, 0.1);
}

.focus-section .group-title {
  color: #6f4a10;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.product-card {
  min-width: 0;
  min-height: 174rpx;
  padding: 12rpx 6rpx 9rpx;
  border-radius: 14rpx;
  background: rgba(255, 253, 248, 0.96);
  border: 1rpx solid rgba(211, 189, 154, 0.58);
  box-shadow: 0 5rpx 14rpx rgba(64, 44, 16, 0.04);
  box-sizing: border-box;
}

.product-card.focus-product {
  border-color: rgba(213, 167, 86, 0.62);
  background:
    linear-gradient(145deg, rgba(245, 218, 164, 0.2), rgba(255, 253, 248, 0) 62%),
    #fffdf8;
  box-shadow: 0 7rpx 17rpx rgba(121, 78, 19, 0.07);
}

.product-card:active {
  transform: translateY(1rpx) scale(0.985);
  background: #fff8ed;
}

.product-image-wrap {
  width: 84rpx;
  height: 84rpx;
  margin: 0 auto;
  border-radius: 17rpx;
  background: rgba(255, 247, 237, 0.9);
  border: 1rpx solid rgba(211, 189, 154, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.focus-product .product-image-wrap {
  background: rgba(255, 248, 230, 0.94);
  border-color: rgba(213, 167, 86, 0.46);
}

.product-image {
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 70rpx;
  height: 70rpx;
  display: block;
  background: #fff7ed;
}

.focus-product .product-image {
  background: #fff8e6;
}

.product-fallback {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  background: #3b2d1c;
  color: #fff7e8;
  font-size: 23rpx;
  font-weight: 900;
  text-align: center;
}

.product-name {
  display: -webkit-box;
  margin-top: 8rpx;
  min-height: 48rpx;
  max-height: 48rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #2b231b;
  font-size: 20rpx;
  line-height: 24rpx;
  font-weight: 800;
  text-align: center;
  word-break: break-all;
}

@media (max-width: 340px) {
  .product-grid {
    gap: 9rpx;
  }

  .product-card {
    padding-left: 4rpx;
    padding-right: 4rpx;
  }

  .product-name {
    font-size: 19rpx;
  }
}
