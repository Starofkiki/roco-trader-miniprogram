.product-detail-page {
  padding-top: 28rpx;
}

.detail-hero,
.info-card,
.stats-card {
  border-radius: 22rpx;
  background: rgba(255, 253, 248, 0.97);
  border: 1rpx solid rgba(211, 189, 154, 0.68);
  box-shadow: 0 12rpx 30rpx rgba(69, 48, 20, 0.075);
}

.detail-hero {
  position: relative;
  overflow: hidden;
  padding: 32rpx 30rpx;
  background:
    radial-gradient(circle at 10% 12%, rgba(238, 205, 146, 0.25), transparent 34%),
    linear-gradient(145deg, #fffdf8 0%, #fff7e9 100%);
}

.detail-hero::after {
  position: absolute;
  right: -72rpx;
  bottom: -112rpx;
  width: 250rpx;
  height: 250rpx;
  border: 1rpx solid rgba(157, 117, 54, 0.1);
  border-radius: 999rpx;
  content: '';
}

.hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.product-image-shell {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background: rgba(255, 252, 244, 0.9);
  border: 1rpx solid rgba(190, 151, 91, 0.44);
  box-shadow:
    inset 0 0 0 8rpx rgba(255, 255, 255, 0.48),
    0 12rpx 28rpx rgba(110, 75, 25, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.image-halo {
  position: absolute;
  width: 132rpx;
  height: 132rpx;
  border-radius: 999rpx;
  background: rgba(236, 193, 115, 0.18);
  filter: blur(2rpx);
}

.product-image {
  position: absolute;
  z-index: 1;
  width: 154rpx;
  height: 154rpx;
  display: block;
}

.detail-main {
  flex: 1;
  min-width: 0;
}

.detail-title {
  display: block;
  color: #241b10;
  font-size: 46rpx;
  line-height: 58rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
  word-break: break-all;
}

.type-pill {
  display: inline-flex;
  align-items: center;
  height: 42rpx;
  margin-top: 14rpx;
  padding: 0 16rpx;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 42rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.type-pill.normal {
  background: #f8edc9;
  border-color: #ead691;
  color: #795b17;
}

.type-pill.daily-hot {
  background: #e4f0f4;
  border-color: #bfd8e0;
  color: #3c6572;
}

.type-pill.fixed-hot {
  background: #eee7f3;
  border-color: #d4c1df;
  color: #6b547b;
}

.trade-meta {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-wrap: wrap;
}

.limit-text,
.price-text {
  color: #5f4930;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 800;
  white-space: nowrap;
}

.price-row {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.coin-image {
  width: 30rpx;
  height: 30rpx;
  display: block;
  flex-shrink: 0;
}

.info-card,
.stats-card {
  margin-top: 24rpx;
}

.info-card {
  padding: 30rpx;
}

.info-section {
  min-width: 0;
}

.info-title,
.stats-title {
  display: block;
  color: #3f3020;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.info-content {
  display: block;
  margin-top: 15rpx;
  color: #3b3127;
  font-size: 27rpx;
  line-height: 45rpx;
  word-break: break-all;
}

.info-divider {
  height: 1rpx;
  margin: 27rpx 0;
  background: rgba(205, 181, 145, 0.48);
}

.obtain-list {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.obtain-row {
  display: flex;
  align-items: flex-start;
  gap: 13rpx;
}

.obtain-dot {
  width: 9rpx;
  height: 9rpx;
  margin-top: 15rpx;
  border-radius: 999rpx;
  background: #c4954d;
  flex-shrink: 0;
}

.obtain-text {
  flex: 1;
  min-width: 0;
  color: #44372b;
  font-size: 26rpx;
  line-height: 39rpx;
  word-break: break-all;
}

.stats-card {
  padding: 28rpx 22rpx 30rpx;
}

.stats-title {
  margin-left: 8rpx;
}

.stats-grid {
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
}

.stat-item {
  flex: 1;
  min-width: 0;
  padding: 0 9rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-divider {
  width: 1rpx;
  min-height: 96rpx;
  background: rgba(205, 181, 145, 0.52);
  flex-shrink: 0;
}

.stat-label {
  color: #796b5c;
  font-size: 21rpx;
  line-height: 30rpx;
  font-weight: 700;
  white-space: nowrap;
}

.stat-value {
  display: block;
  margin-top: 12rpx;
  color: #2b2116;
  font-weight: 900;
  white-space: nowrap;
}

.last-seen-value {
  font-size: 28rpx;
  line-height: 38rpx;
}

.count-value {
  font-size: 36rpx;
  line-height: 42rpx;
  color: #7a521d;
}

.stat-subvalue {
  display: block;
  margin-top: 2rpx;
  color: #655545;
  font-size: 21rpx;
  line-height: 30rpx;
  font-weight: 700;
  white-space: nowrap;
}

.season-stats-divider {
  height: 1rpx;
  margin: 28rpx 8rpx 24rpx;
  background: rgba(205, 181, 145, 0.48);
}

.season-stats-title {
  display: block;
  margin: 0 8rpx;
  color: #5c452b;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.season-rate-list {
  margin-top: 16rpx;
  padding: 2rpx 8rpx;
  border-radius: 16rpx;
  background: rgba(255, 248, 234, 0.72);
}

.season-rate-row {
  min-height: 66rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.season-rate-row + .season-rate-row {
  border-top: 1rpx solid rgba(205, 181, 145, 0.38);
}

.season-rate-label {
  min-width: 0;
  color: #6e5e4d;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 700;
}

.season-rate-value {
  color: #7a521d;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

.season-data-note {
  display: block;
  margin: 13rpx 10rpx 0;
  color: #9a8873;
  font-size: 20rpx;
  line-height: 30rpx;
}

@media (max-width: 340px) {
  .detail-hero {
    padding: 28rpx 24rpx;
  }

  .hero-content {
    gap: 22rpx;
  }

  .product-image-shell {
    width: 174rpx;
    height: 174rpx;
  }

  .product-image {
    width: 142rpx;
    height: 142rpx;
  }

  .detail-title {
    font-size: 42rpx;
    line-height: 52rpx;
  }

  .stats-card {
    padding-left: 16rpx;
    padding-right: 16rpx;
  }

  .stat-label {
    font-size: 19rpx;
  }

  .last-seen-value {
    font-size: 25rpx;
  }

  .season-rate-row {
    padding-left: 10rpx;
    padding-right: 10rpx;
  }

  .season-rate-label {
    font-size: 21rpx;
  }
}
