page {
  background: #f8f1e7;
}

.announcements-page {
  padding-top: 30rpx;
  padding-bottom: calc(42rpx + env(safe-area-inset-bottom));
}

.page-heading {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #ead9bf;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffedc4 0%, #fff9eb 58%, #fffdf8 100%);
  box-shadow: 0 14rpx 32rpx rgba(91, 61, 20, 0.08);
}

.page-heading::before,
.page-heading::after {
  content: '';
  position: absolute;
  border-radius: 999rpx;
}

.page-heading::before {
  right: -42rpx;
  top: -66rpx;
  width: 190rpx;
  height: 190rpx;
  background: rgba(235, 154, 25, 0.13);
}

.page-heading::after {
  right: 76rpx;
  bottom: -58rpx;
  width: 120rpx;
  height: 120rpx;
  border: 2rpx solid rgba(183, 112, 9, 0.12);
}

.page-title,
.page-subtitle,
.state-title,
.state-copy,
.announcement-date,
.announcement-title,
.read-more,
.list-end {
  display: block;
}

.page-title {
  position: relative;
  z-index: 1;
  color: #201a12;
  font-size: 40rpx;
  line-height: 52rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.page-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 8rpx;
  color: #7b6d59;
  font-size: 24rpx;
  line-height: 34rpx;
}

.page-count {
  position: relative;
  z-index: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  margin-top: 20rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(160, 95, 4, 0.14);
  border-radius: 999rpx;
  background: rgba(255, 253, 248, 0.72);
  color: #9a5c05;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 800;
}

.announcement-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.announcement-card,
.state-card {
  box-sizing: border-box;
  border: 1rpx solid #ead9bf;
  border-radius: 22rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 28rpx rgba(74, 51, 21, 0.07);
}

.announcement-card {
  position: relative;
  overflow: hidden;
  padding: 27rpx 28rpx 25rpx;
}

.announcement-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 28rpx;
  bottom: 28rpx;
  width: 5rpx;
  border-radius: 0 999rpx 999rpx 0;
  background: #ead9bf;
}

.announcement-card.pinned {
  border-color: #e4c177;
  background: linear-gradient(135deg, #fff5d9 0%, #fffdf8 70%);
  box-shadow: 0 14rpx 30rpx rgba(145, 91, 9, 0.1);
}

.announcement-card.pinned::before {
  background: #e29a20;
}

.announcement-card:active {
  transform: translateY(1rpx);
  opacity: 0.88;
}

.announcement-meta,
.announcement-title-row {
  display: flex;
  align-items: center;
}

.announcement-meta {
  min-height: 42rpx;
  gap: 12rpx;
}

.pinned-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #e9a029;
  color: #4b3006;
  font-size: 19rpx;
  line-height: 1;
  font-weight: 900;
}

.announcement-date {
  color: #9a8060;
  font-size: 21rpx;
  line-height: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.announcement-title-row {
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 11rpx;
}

.announcement-title {
  flex: 1;
  min-width: 0;
  color: #282016;
  font-size: 31rpx;
  line-height: 43rpx;
  font-weight: 900;
  word-break: break-all;
}

.announcement-arrow {
  flex: 0 0 auto;
  color: #c18a31;
  font-size: 45rpx;
  line-height: 45rpx;
}

.read-more {
  margin-top: 14rpx;
  padding-top: 15rpx;
  border-top: 1rpx solid #f0e5d4;
  color: #a66709;
  font-size: 21rpx;
  line-height: 31rpx;
  font-weight: 800;
}

.state-card {
  padding: 58rpx 30rpx;
  color: #857765;
  font-size: 25rpx;
  line-height: 38rpx;
  text-align: center;
}

.state-title {
  color: #33291d;
  font-size: 29rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.state-copy {
  margin-top: 10rpx;
  color: #857765;
  font-size: 23rpx;
  line-height: 34rpx;
}

.retry-button,
.load-more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 76rpx;
  margin: 26rpx 0 0;
  padding: 0;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #f7b72d 0%, #e08b18 100%);
  color: #3d2807;
  font-size: 25rpx;
  line-height: 1;
  font-weight: 900;
}

.retry-button {
  width: 220rpx;
  margin-right: auto;
  margin-left: auto;
}

.load-more-button {
  width: 100%;
  margin-top: 4rpx;
}

.retry-button::after,
.load-more-button::after {
  border: 0;
}

.inline-error {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff0ec;
  color: #9f4939;
  font-size: 22rpx;
}

.retry-link {
  color: #a56200;
  font-weight: 900;
}

.list-end {
  padding: 18rpx 0 4rpx;
  color: #9b8e7c;
  font-size: 22rpx;
  text-align: center;
}
